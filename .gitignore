
# ==========================================
# Mini ROV Simulator - Git Ignore
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ---------- uv ----------
# Keep uv.lock tracked for reproducible environments.
# Do not ignore uv.lock.

# ---------- C++ / CMake ----------
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
Makefile

# Compiled binaries and objects
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.out
*.pdb
*.ilk
*.pch
*.idb

# ---------- Visual Studio ----------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
ipch/

# ---------- VS Code ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ---------- Logs ----------
*.log
logs/
*.tmp

.vscode

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Environment and Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Project-specific ----------
simulation-output/
telemetry-logs/
